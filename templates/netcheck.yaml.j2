# Managed by Ansible (demigods.yml) - temporary pod network smoke test
apiVersion: v1
kind: Namespace
metadata:
  name: {{ netcheck_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: netcheck
  namespace: {{ netcheck_namespace }}
spec:
  selector:
    matchLabels:
      app: netcheck
  template:
    metadata:
      labels:
        app: netcheck
    spec:
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      terminationGracePeriodSeconds: 1
      containers:
        - name: netcheck
          image: {{ netcheck_image }}
          command: ["sh", "-c", "sleep 86400"]
          resources:
            requests:
              cpu: 10m
              memory: 8Mi
